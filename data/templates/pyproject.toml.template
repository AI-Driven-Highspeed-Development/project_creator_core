[project]
name = "{project_name}"
version = "0.1.0"
description = "{description}"
readme = "README.md"
requires-python = ">=3.11"
dependencies = []

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.uv.workspace]
members = ["cores/*", "managers/*", "utils/*", "plugins/*", "mcps/*"]

[tool.hatch.build.targets.wheel]
packages = ["."]
